datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        // ADMIN, DOCTOR, RECEPTIONIST
  specialty    String?       // e.g. "General Medicine", "Internal Medicine"
  phone        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  visits       Visit[]
  appointments Appointment[]
  auditLogs    AuditLog[]
}

model Patient {
  id                    String        @id @default(uuid())
  uhid                  String        @unique // e.g. CP-2026-0001
  name                  String
  age                   Int
  dob                   String?
  gender                String        // Male, Female, Other
  phone                 String
  email                 String?
  address               String?
  idNumber              String?       // Aadhaar / National ID
  emergencyContactName  String?
  emergencyContactPhone String?
  knownAllergies        String?
  bloodGroup            String?
  consentGiven          Boolean       @default(true) // DPDP Act consent
  consentDate           DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  visits                Visit[]
  appointments          Appointment[]
}

model Visit {
  id                  String         @id @default(uuid())
  patientId           String
  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              User           @relation(fields: [doctorId], references: [id])
  templateId          String?
  template            Template?      @relation(fields: [templateId], references: [id])
  
  visitDate           DateTime       @default(now())
  chiefComplaints     String         // e.g. "Severe cough and mild fever (4 days)"
  duration            String?
  hpi                 String?        // History of Present Illness
  pastHistory         String?        // Medical and Surgical history
  familyHistory       String?
  currentMedications  String?
  allergies           String?
  lifestyleDiet       String?
  lifestyleSleep      String?
  lifestyleHabits     String?

  // Vitals & Physical Examination
  bpSystolic          Int?
  bpDiastolic         Int?
  pulse               Int?
  temperature         Float?
  weight              Float?         // in kg
  height              Float?         // in cm
  bmi                 Float?
  bmiCategory         String?        // Normal, Overweight, Obese, Underweight
  spo2                Int?
  clinicalFindings    String?        // General exam & systemic findings

  // Diagnosis, Investigations & Treatment
  provisionalDiagnosis String
  testsOrdered        String?
  advice              String?
  followUpDate        String?        // YYYY-MM-DD
  followUpNotes       String?
  customFields        String?        @default("{}") // JSON string for specialty template fields
  status              String         @default("COMPLETED") // DRAFT, COMPLETED

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  prescriptions       Prescription[]
}

model Prescription {
  id           String   @id @default(uuid())
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicineName String   // e.g. "Paracetamol 650mg"
  dosage       String   // e.g. "1 tablet"
  frequency    String   // e.g. "1-0-1 (Twice daily after food)"
  duration     String   // e.g. "5 days"
  instructions String?  // e.g. "Take after meals with warm water"
  createdAt    DateTime @default(now())
}

model Appointment {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User     @relation(fields: [doctorId], references: [id])
  appointmentDate String   // YYYY-MM-DD
  timeSlot        String   // e.g. "10:30 AM"
  reason          String?
  status          String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Template {
  id           String   @id @default(uuid())
  name         String   // General Medicine, Homeopathy, Dental, Pediatrics
  specialty    String
  description  String?
  fieldsConfig String   // JSON string representing enabled sections and extra fields
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  visits       Visit[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  userRole  String?
  action    String   // LOGIN, VIEW_PATIENT, CREATE_PATIENT, EDIT_PATIENT, CREATE_VISIT, EDIT_VISIT, EXPORT_PDF, USER_CREATE, USER_UPDATE
  entity    String   // Patient, Visit, Prescription, User, Template, Auth
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}
